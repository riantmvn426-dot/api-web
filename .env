# ── Storage (LOCAL JSON FILE — tidak pakai DongtubeDB) ──────────
DB_MODE=local
CDN_MODE=local
DATA_DIR=/root/miku/data
CDN_DIR=/root/miku/storage/cdn
CDN_INDEX=/root/miku/data/cdn-index.json

# ── Server ───────────────────────────────────
PORT=4020
NODE_ENV=production
TOKEN_SECRET=3aa9e854caef9b4573456e7128b089867bf3b2dc401dc52f5b3de779f68f3946

# ── Admin ────────────────────────────────────
ADMIN_PASS=wxvw1cAvHpBEYi
ADMIN_PATH=admin

# ── API Key Auth (wajib untuk semua endpoint /api/*) ─
# Pisahkan beberapa key dengan koma: key1,key2,key3
MIKUAI_API_KEYS=mikuapi

# ── Rate Limit ───────────────────────────────
FREE_API_RATE_LIMIT=15
FREE_API_RATE_WINDOW=60000

# ── CDN ──────────────────────────────────────
CDN_MAX_SIZE_MB=100
CORS_ORIGIN=*
